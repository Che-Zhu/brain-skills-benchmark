# =============================================================================
# Benchmark 运行控制
# =============================================================================
# 本次处理的仓库数量（按 template 队列顺序取前 N）；省略则处理全部
# BENCHMARK_LIMIT=5
# BENCHMARK_DEVBOX_MAX_DURATION_MINUTES=300
# BENCHMARK_DEVBOX_BOOTSTRAP_TIMEOUT_MS=120000
# BENCHMARK_DEVBOX_RUNNING_TIMEOUT_MS=300000
# BENCHMARK_TURN_POLL_MS=10000
# BENCHMARK_TURN_TIMEOUT_MS=1800000
# SMOKE_REPO=ollama/ollama

# =============================================================================
# Sealos Template（队列 + dryRun 部署校验）
# =============================================================================
# App Store 列表，benchmark 队列来源
SEALOS_TEMPLATE_API_URL=https://template.usw-1.sealos.io/api/listTemplate?language=en
# POST 完整 URL（body: yaml + dryRun:true）
SEALOS_TEMPLATE_API_URL_DEPLOY=https://template.usw-1.sealos.io/api/v2alpha/templates/raw
# URL-encoded kubeconfig（Authorization 头）；勿在 = 后加空格
# SEALOS_KUBECONFIG=

# =============================================================================
# Devbox / Sealos 集群
# =============================================================================
# 自建集群 admin kubeconfig 本地路径（勿提交；用于 kubectl 排查 Devbox）
# SEALOS_189_KUBECONFIG_PATH=.kube/189-admin.yaml
SEALOS_HOST=your-sealos-host.example.com
# DEVBOX_BASE_URL=https://devbox-server.your-sealos-host.example.com
DEVBOX_JWT_SIGNING_KEY=
# DEVBOX_TOKEN=
# DEVBOX_NAMESPACE=ns-test
# DEVBOX_RUNTIME_IMAGE=...
# 自建集群：Devbox fetch + Template dryRun kubeconfig 跳过 TLS 校验
DEVBOX_TLS_INSECURE=1
# SEALOS_TLS_INSECURE=1

# =============================================================================
# Sandbox Skill
# =============================================================================
BRAIN_SANDBOX_SKILLS_GIT=https://github.com/zjy365/sealos-skills/tree/sandbox-skill-lite

# =============================================================================
# Codex Gateway（Devbox 内 agent；与 Brain UI 相同变量名）
# =============================================================================
CODEX_GATEWAY_OPENAI_API_KEY=
# CODEX_GATEWAY_OPENAI_BASE_URL=
# CODEX_GATEWAY_MODEL=

# =============================================================================
# GitHub（注入 Devbox，供 skill 推镜像等；clone 仍用公网 URL 无需 token）
# =============================================================================
GITHUB_TOKEN=
