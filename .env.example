# Sealos / Devbox
SEALOS_HOST=your-sealos-host.example.com
# 若 Devbox API 不在 devbox-server.<SEALOS_HOST>，可整 origin 覆盖：
# DEVBOX_BASE_URL=https://devbox-server.your-sealos-host.example.com
# 本地 / 自签证书集群：Node fetch 默认校验 TLS，浏览器可能已手动信任
DEVBOX_TLS_INSECURE=1
DEVBOX_JWT_SIGNING_KEY=
# 或使用静态 token（二选一）
# DEVBOX_TOKEN=
# DEVBOX_NAMESPACE=ns-test
# DEVBOX_RUNTIME_IMAGE=...

# GitHub（必填；注入 Devbox，供 sandbox skill 推镜像等；clone 仍用公网 URL 无需 token）
GITHUB_TOKEN=

# Codex Gateway（Devbox 内 agent；与 Brain UI 相同变量名）
CODEX_GATEWAY_OPENAI_API_KEY=
# CODEX_GATEWAY_OPENAI_BASE_URL=
# CODEX_GATEWAY_MODEL=

# 本次 benchmark 处理的仓库数量（按文件顺序取前 N）；省略则处理 top1000-representative-deployable-apps.json 全部条目
# BENCHMARK_LIMIT=5

# Devbox pause 时长（分钟，默认 300）
# BENCHMARK_DEVBOX_MAX_DURATION_MINUTES=300
# Bootstrap 等待 Running + in-pod exec SDK + 脚本（毫秒，默认 120000）
# BENCHMARK_DEVBOX_BOOTSTRAP_TIMEOUT_MS=120000
# Gateway turn 轮询间隔（毫秒，默认 10000 = 10 秒）
# BENCHMARK_TURN_POLL_MS=10000
# Gateway turn 超时（毫秒，阶段 3）
# BENCHMARK_TURN_TIMEOUT_MS=1800000
# 阶段 2 冒烟默认仓库
# SMOKE_REPO=ollama/ollama

# 必填：Devbox 内 npx skills add 的技能仓库（含分支时用 /tree/<branch>）
# 不使用 ShipRepo 的 brain-github-deploy
BRAIN_SANDBOX_SKILLS_GIT=https://github.com/zjy365/sealos-skills/tree/sandbox-skill-lite
