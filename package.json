{
  "name": "brain-skills-benchmark",
  "version": "0.2.0",
  "private": true,
  "description": "sealos-deploy 自动化部署与契约验证（无 Brain UI）",
  "type": "module",
  "bin": {
    "brain-skills-benchmark": "./bin/benchmark.mjs"
  },
  "scripts": {
    "benchmark": "node ./bin/benchmark.mjs",
    "deploy": "tsx src/brain-deploy/deploy/run.ts",
    "validate": "node ./bin/benchmark.mjs validate",
    "suite": "node ./bin/benchmark.mjs suite",
    "test": "node --test ./tests/*.test.mjs",
    "fixtures:generate": "node ./scripts/generate-fixtures.mjs",
    "cases:sync": "node ./scripts/sync-eval-cases.mjs"
  },
  "dependencies": {
    "jose": "^6.0.11",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
